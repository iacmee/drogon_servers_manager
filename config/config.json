{
    "app": {
        "bind": "192.168.1.159",
        "allowed_origins": ["https://minecraft.brunialti.online"],
        "port": 26000,
        "threads": 2,
        "java_path": "/usr/bin/java",
        "document_root": "/home/iacme/Desktop/https/static",
        "backup_root": "/home/iacme/Downloads/PaperPilot-1.0.0/backups",
        "database_file": "/home/iacme/Desktop/https/db/database.db",
        "https": {
            "enabled": false
        },
        "session": {
            "enabled": true,
            "timeout": 3600
        }
    },
    "plugins": [
        {
            "name": "drogon::plugin::RealIpResolver",
            "dependencies": [],
            "config": {
                "trust_ips": ["192.168.1.37"],
                "from_header": "x-forwarded-for"
            }
        },
        {
            "name": "drogon::plugin::Hodor",
            "dependencies": ["drogon::plugin::RealIpResolver"],
            "config": {
                "algorithm": "sliding_window",
                "urls": [
                    "^/api/auth/login$"
                ],
                "time_unit": 60,
                "capacity": 1000,
                "ip_capacity": 20,
                "user_capacity": 15,
                "multi_threads": true,
                "use_real_ip_resolver": true,
                "rejection_message": "Too many authentication attempts",
                "limiter_expire_time": 600,
                "trust_ips": []
            }
        },
        {
            "name": "drogon::plugin::AccessLogger",
            "dependencies": ["drogon::plugin::RealIpResolver"],
            "config": {
                "use_spdlog": false,
                "use_real_ip": true,
                "log_path": "./logs",
                "log_file": "access.log",
                "log_index": 1,
                "log_size_limit": 10485760,
                "max_files": 5,
                "use_local_time": true,
                "show_microseconds": false,
                "log_format": "$request_date $remote_addr $method $path $status_code $body_bytes_sent $processing_time"
            }
        }
    ],

  "servers": [
        {
            "id" : 1,
            "name": "test_server",
            "jarPath": "/home/iacme/Desktop/https/import/test_server/paper-26.3-191.jar",
            "directory": "/home/iacme/Desktop/https/import/test_server",
            "service": "minecraft_server_blueprint.service",
            "logPath": "/home/iacme/Desktop/https/import/test_server/logs/latest.log"
        },
        {
            "id" : 2,
            "name": "test_server_2",
            "jarPath": "/home/iacme/Desktop/https/import/test_server_2/paper-26.3-191.jar",
            "directory": "/home/iacme/Desktop/https/import/test_server_2",
            "service": "minecraft_server_blueprint.service",
            "logPath": "/home/iacme/Desktop/https/import/test_server_2/logs/latest.log"
        }
    ]
}
